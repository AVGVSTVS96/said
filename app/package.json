{
  "name": "said-ui",
  "private": true,
  "type": "module",
  "scripts": {
    "generate": "bun scripts/product.ts && cargo run --quiet -p said-core --bin export-types",
    "dev": "bun run generate && vite",
    "build": "bun run generate && tsc --noEmit && vite build",
    "typecheck": "bun run generate && tsc --noEmit",
    "tauri": "bun scripts/product.ts && tauri",
    "test": "bun test"
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.4",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.4",
    "@types/bun": "catalog:",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "typescript": "catalog:",
    "vite": "8.3.6"
  }
}
