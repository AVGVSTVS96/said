{
  "name": "said-ui",
  "private": true,
  "type": "module",
  "scripts": {
    "generate": "bun scripts/product.ts && cargo run --quiet -p said-core --bin export-types",
    "dev": "bun run generate && vite",
    "build": "bun run generate && tsc --noEmit && vite build",
    "typecheck": "bun run generate && tsc --noEmit",
    "tauri": "bun scripts/product.ts && tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.2",
    "@types/bun": "^1.3.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
