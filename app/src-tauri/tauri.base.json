{
  "$schema": "https://schema.tauri.app/config/2",
  "build": {
    "beforeDevCommand": "bun run dev",
    "beforeBuildCommand": "bun run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "overlay",
        "url": "index.html?screen=overlay",
        "title": "Dictation",
        "width": 544,
        "height": 216,
        "visible": false,
        "focus": false,
        "focusable": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "decorations": false,
        "transparent": true
      },
      {
        "label": "interactive",
        "url": "index.html?screen=interactive",
        "title": "Review",
        "width": 624,
        "height": 269,
        "visible": false,
        "decorations": false,
        "transparent": true,
        "resizable": true,
        "center": true,
        "minWidth": 624,
        "maxWidth": 624,
        "minHeight": 269,
        "maxHeight": 269
      },
      {
        "label": "history",
        "url": "index.html?screen=history",
        "title": "History",
        "width": 800,
        "height": 640,
        "visible": false
      },
      {
        "label": "settings",
        "url": "index.html?screen=settings",
        "title": "Settings",
        "width": 640,
        "height": 680,
        "visible": false
      },
      {
        "label": "setup",
        "url": "index.html?screen=setup",
        "title": "Setup",
        "width": 640,
        "height": 680
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost; media-src 'self' voice-audio: http://voice-audio.localhost blob:"
    },
    "macOSPrivateApi": true,
    "enableGTKAppId": true
  },
  "bundle": {
    "active": false,
    "macOS": {
      "minimumSystemVersion": "15.0",
      "infoPlist": "Info.plist"
    }
  }
}
