pkgname=said
pkgver=$(sed -n 's/^version = "\(.*\)"/\1/p' "${SAID_REPO:-$startdir/../..}/Cargo.toml" | head -n1)
pkgrel=1
pkgdesc='Local dictation with Parakeet v3'
arch=('x86_64')
license=('MIT')
depends=('webkit2gtk-4.1' 'libayatana-appindicator' 'gtk-layer-shell' 'alsa-lib' 'wl-clipboard' 'libxkbcommon' 'util-linux')
makedepends=('rust' 'bun' 'git' 'curl' 'jq' 'openssl' 'bzip2' 'python')
options=('!lto' '!debug' '!strip')
source=("said::git+file://${SAID_REPO:-$(cd "$startdir/../.." && pwd)}#commit=${SAID_REVISION:-$(git -C "$startdir/../.." rev-parse HEAD)}")
sha256sums=('SKIP')

build() {
    cd "$srcdir/said"
    export CFLAGS='-O2 -pipe' CXXFLAGS='-O2 -pipe' MAKEFLAGS='-j2'
    source packaging/build-env.sh
    cd app
    bun install --frozen-lockfile
    bun run build
    cd ..
    cargo build --locked --release -p said-app --features custom-protocol --bin said
}

package() {
    "$srcdir/said/packaging/linux/install.sh" "$pkgdir/usr"
    python3 "$srcdir/said/packaging/check-private-paths.py" "$pkgdir"
}
